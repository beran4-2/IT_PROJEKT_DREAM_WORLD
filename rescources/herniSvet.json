  "otazky": [
    {
      "kdoMluvi": "Doktor",
      "id": 101,
      "replika": "Tvuj otec to nezvladl, zemrel z vycerpani, je mi to moc lito",
      "odpovediNaOtazky": [
        {
          "text": "Dekuji, je to pro me velmi tezke v poselednich dnech",
          "IdNasledneOtazky": 102
        },
        {
          "text": "jeste ty me tim zatezu, spis bys me mel nechat byt.",
          "IdNasledneOtazky": 103
        }
      ]
    },
    {
      "kdoMluvi": "Doktor",
      "id": 102,
      "replika": "Nasli jsme nejake veci tveho otce rikal jsem si ze by se ti mohli hodit ",
      "odpovediNaOtazky": [
        {
          "text": "Dekuji za nabidku, asi je nechci necham je otci.",
          "IdNasledneOtazky": 105        },
        {
          "text": "Dekuji vezmu si je, mozna se mi nekdy budou hodit.",
          "IdNasledneOtazky": 104
        }
      ]
    },
    {
      "kdoMluvi": "Doktor",
      "id": 103,
      "replika": "Dobre jak si prejes dam ti prostor",
      "odpovediNaOtazky": [
        {
          "text": "Dekuji",
          "IdNasledneOtazky": 105
        }
      ]
    },
    {
      "kdoMluvi": "Doktor",
      "id": 104,
      "replika": "A mimochodem kdykoliv muzes zamnou dorazit se nechat osetrit",
      "odpovediNaOtazky": [
        {
          "text": "Dobre",
          "IdNasledneOtazky": -101
        }
      ]
    },
    {
      "kdoMluvi": "Doktor",
      "id": 105,
      "replika": "A mimochodem kdykoliv muzes zamnou dorazit se nechat osetrit",
      "odpovediNaOtazky": [
        {
          "text": "Dobre",
          "IdNasledneOtazky": -102
        }
      ]
    },

    {
      "kdoMluvi": "Doktor",
      "id": 110,
      "replika": "Chces osetrit.",
      "odpovediNaOtazky": [
        {
          "text": "Ano prosim",
          "IdNasledneOtazky": 111
        },
        {
          "text": "Ne dekuji",
          "IdNasledneOtazky": -111
        }
      ]
    },
    {
      "kdoMluvi": "Doktor",
      "id": 111,
      "replika": "Hotovo. Mel by ses citit lepe. Davat na sebe pozor, sny nejsou bezpecne.",
      "odpovediNaOtazky": [
        {
          "text": "Dekuju",
          "IdNasledneOtazky": -110
        }
      ]
    },


    {
      "kdoMluvi": "Mulier",
      "id": 201,
      "replika": "Co se deje?",
      "odpovediNaOtazky": [
        {
          "text": "Videl jsem strasne veci, to zlo ktere uz otec nedrzi se probudilo a chce zotrocit vsechny lidi ve meste",
          "IdNasledneOtazky": 202
        }
      ]
    },
    {
      "kdoMluvi": "Mulier",
      "id": 202,
      "replika": "Da se s tim neco delat? Nebo uteceme",
      "odpovediNaOtazky": [
        {
          "text": "Utikat nebudeme, musime to resit",
          "IdNasledneOtazky": 203
        },
        {
          "text": "Nekdo by me napadl",
          "IdNasledneOtazky": 204
        }
      ]
    },
    {
      "kdoMluvi": "Mulier",
      "id": 203,
      "replika": "Co takhle jit za Magou, ta by ti mohla pomoct",
      "odpovediNaOtazky": [
        {
          "text": "Mohla by, ale nesnasi me",
          "IdNasledneOtazky": 214
        },
        {
          "text": "To jo, ale nesnasi me, protoze neumim ovladat svoje schopnosti",
          "IdNasledneOtazky": 215
        }
      ]
    },
    {
      "kdoMluvi": "Mulier",
      "id": 204,
      "replika": "Kdo te napadl ",
      "odpovediNaOtazky": [
        {
          "text": "Maga ale nesnasi me, protoze nedokazu ovladat svoje schopnosti",
          "IdNasledneOtazky": 215
        },
        {
          "text": "Maga ale nesnasi me",
          "IdNasledneOtazky": 214
        }
      ]
    },

    {
      "kdoMluvi": "Mulier",
      "id": 214,
      "replika": "Proc te nesnasi?",
      "odpovediNaOtazky": [
        {
          "text": "Nevim jestli se mi chce ti to rikat",
          "IdNasledneOtazky": 215
        },
        {
          "text": "Nesnasi me protoze neumim ovladat svoje schopnosti",
          "IdNasledneOtazky": 215
        }
      ]
    },
    {
      "kdoMluvi": "Mulier",
      "id": 215,
      "replika": "Jestli s tim chces neco delat tak je to asi nejlepsi volba",
      "odpovediNaOtazky": [
        {
          "text": "Asi jo pujdu tam s tim ze umim lucidne snit",
          "IdNasledneOtazky": -201
        },
        {
          "text": "Asi jo pujdu tam s tim ze umim daydreaming",
          "IdNasledneOtazky": -202
        }
      ]
    },


    {
      "kdoMluvi": "baba Maga",
      "id": 301,
      "replika": "Co ty tu delas?",
      "odpovediNaOtazky": [
        {
          "text": "Budu potrebovat pomoc",
          "IdNasledneOtazky": 302
        }
      ]
    },
    {
      "kdoMluvi": "baba Maga",
      "id": 302,
      "replika": "Ty si delas asi srandu ne? S cim jako?",
      "odpovediNaOtazky": [
        {
          "text": "Videl jsem hrozne veci ve snu, zlo, ktere chce ovladnout celou planetu",
          "IdNasledneOtazky": 303
        }
      ]
    },
    {
      "kdoMluvi": "baba Maga",
      "id": 303,
      "replika": "Takt to budeme muset rychle zacit s pripravou. Tvoje schopnosti jsou slabe, ale potencial mas obrovsky. Pujdes trenovat.",
      "odpovediNaOtazky": [
        {
          "text": "Co mam delat jako prvni?",
          "IdNasledneOtazky": 304
        },
        {
          "text": "Nejsem si jisty jestli to zvladnu",
          "IdNasledneOtazky": 305
        }
      ]
    },
    {
      "kdoMluvi": "baba Maga",
      "id": 304,
      "replika": "U jezera vytvoris most jen pomoci sve mysli. A co chces vylepsit pomoci prastareho kouzla?",
      "odpovediNaOtazky": [
        {
          "text": "Chtel bych zlepsit daydreaming",
          "IdNasledneOtazky": -301
        },
        {
          "text": "Chtel bych zlepsit lucidni sneni",
          "IdNasledneOtazky": -302
        }
      ]
    },
    {
      "kdoMluvi": "baba Maga",
      "id": 305,
      "replika": "Pochybnosti te zabiji driv nez zlo. Pokud uteces ted, mesto padne.",
      "odpovediNaOtazky": [
        {
          "text": "Mas pravdu pujdu trenovat",
          "IdNasledneOtazky": 304
        }
      ]
    },

    {
      "kdoMluvi": "baba Maga",
      "id": 340,
      "replika": "Most jsi vytvoril lepe nez jsem cekala. Tvuj otec by byl hrdy. Ale sila sama nestaci.",
      "odpovediNaOtazky": [
        {
          "text": "Co tim myslis?",
          "IdNasledneOtazky": 341
        },
        {
          "text": "Bylo to tezke ale zvladl jsem to",
          "IdNasledneOtazky": 341
        }
      ]
    },
    {
      "kdoMluvi": "baba Maga",
